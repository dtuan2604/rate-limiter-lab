{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rate-limiter-lab.local/contracts/policy.schema.json",
  "title": "Phase 4 Fixed-Window Policy Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "name",
    "version",
    "status",
    "revision",
    "description",
    "match",
    "identity",
    "algorithm",
    "failureMode",
    "priority",
    "createdAt",
    "createdBy",
    "activatedAt",
    "activatedBy"
  ],
  "properties": {
    "policyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "ACTIVE", "DISABLED", "ARCHIVED"]},
    "revision": {"type": "integer", "minimum": 0},
    "description": {"type": ["string", "null"], "maxLength": 1024},
    "match": {"$ref": "#/$defs/match"},
    "identity": {"$ref": "#/$defs/identity"},
    "algorithm": {"$ref": "#/$defs/algorithm"},
    "failureMode": {"enum": ["FAIL_OPEN", "FAIL_CLOSED"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "createdAt": {"type": "string", "format": "date-time"},
    "createdBy": {"type": "string", "minLength": 1, "maxLength": 128},
    "activatedAt": {"type": ["string", "null"], "format": "date-time"},
    "activatedBy": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeId", "path", "methods"],
      "properties": {
        "routeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/proxy/(?:[^/?#]+/?)*$",
          "maxLength": 512
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"const": "GET"}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "name"],
              "properties": {
                "type": {"const": "HEADER"},
                "name": {"const": "X-Client-Id"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {"type": {"const": "ROUTE"}}
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "configuration"],
      "properties": {
        "type": {"const": "FIXED_WINDOW"},
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "windowMilliseconds"],
          "properties": {
            "limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "windowMilliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          }
        }
      }
    }
  }
}
